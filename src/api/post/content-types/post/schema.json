{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Tite": {
      "type": "string",
      "required": true,
      "unique": false
    },
    "cat_posts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::cat-post.cat-post",
      "mappedBy": "posts"
    },
    "images": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "authors": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "posts"
    },
    "slug": {
      "type": "uid",
      "targetField": "Tite"
    }
  }
}
